+
+// Metadata already consumed internally by temporal upscalers, made available
+// without exposing the scene UBO layout or renderer implementation pointers.
+void RenderSceneDataRD::_bind_methods() {
+    ClassDB::bind_method(D_METHOD("get_temporal_upscaler_data"), &RenderSceneDataRD::get_temporal_upscaler_data);
+}
+
+Dictionary RenderSceneDataRD::get_temporal_upscaler_data() const {
+    Dictionary result;
+    result["jitter"] = taa_jitter;
+    result["delta_seconds"] = time_step;
+    result["z_near"] = z_near;
+    result["z_far"] = z_far;
+    result["fovy"] = Math::deg_to_rad(Projection::get_fovy(cam_projection.get_fov(), 1.0 / cam_projection.get_aspect()));
+    Projection correction;
+    correction.set_depth_correction(true, true, false);
+    result["reprojection"] = (correction * prev_cam_projection) * prev_cam_transform.affine_inverse() * cam_transform * (correction * cam_projection).inverse();
+    return result;
+}
