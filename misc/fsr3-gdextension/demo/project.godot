; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FSR 3.1.6 Temporal Artifact Lab"
run/main_scene="res://artifact_lab.tscn"
config/features=PackedStringArray("4.8")

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540

[rendering]

renderer/rendering_method.mobile="forward_plus"
scaling_3d/mode=7
scaling_3d/scale=0.67
scaling_3d/fsr3/backend=1
scaling_3d/fsr3/library_path="res://amd_runtime/amd_fidelityfx_upscaler_vk.dll"
