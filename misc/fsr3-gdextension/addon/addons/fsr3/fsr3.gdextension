[configuration]
entry_symbol = "fsr3_library_init"
compatibility_minimum = "4.8"
reloadable = false

[libraries]
linux.debug.x86_64 = "bin/libfsr3.linux.template_debug.x86_64.so"
linux.release.x86_64 = "bin/libfsr3.linux.template_release.x86_64.so"

windows.debug.x86_64 = "bin/libfsr3.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "bin/libfsr3.windows.template_release.x86_64.dll"
